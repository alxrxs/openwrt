/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-nss.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Ubiquiti UniFi U6 Enterprise";
	compatible = "ubnt,u6-enterprise", "qcom,ipq5018";

	aliases {
		ethernet0 = &dp2;
		label-mac-device = &dp2;
		serial0 = &blsp1_uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

/* The stock QSEE uses 4 MiB here, twice the SoC default. */
&tz_region {
	reg = <0x0 0x4ac00000 0x0 0x400000>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

/* The bootloader muxes the console pins; GPIO33/34 are I2C on this board. */
&blsp1_uart1 {
	status = "okay";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&blsp1_spi1 {
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		/* Read-only until the install flow is proven: this chip holds the boot chain. */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:sbl1";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "0:mibib";
				reg = <0x030000 0x010000>;
				read-only;
			};

			partition@40000 {
				label = "0:bootconfig";
				reg = <0x040000 0x010000>;
				read-only;
			};

			partition@50000 {
				label = "0:qsee";
				reg = <0x050000 0x0a0000>;
				read-only;
			};

			partition@f0000 {
				label = "0:devcfg";
				reg = <0x0f0000 0x010000>;
				read-only;
			};

			partition@100000 {
				label = "0:cdt";
				reg = <0x100000 0x010000>;
				read-only;
			};

			partition@110000 {
				label = "0:appsblenv";
				reg = <0x110000 0x010000>;
				read-only;
			};

			partition@120000 {
				label = "0:appsbl";
				reg = <0x120000 0x0a0000>;
				read-only;
			};

			partition@1c0000 {
				label = "0:art";
				reg = <0x1c0000 0x070000>;
				read-only;
			};

			partition@230000 {
				label = "eeprom";
				reg = <0x230000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_eeprom_0: macaddr@0 {
						reg = <0x0 0x6>;
					};
				};
			};
		};
	};
};

&sdhc_1 {
	pinctrl-0 = <&emmc_pins>;
	pinctrl-names = "default";
	bus-width = <4>;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
};

/*
 * =================================================================
 *     _______________________
 *    |        IPQ5018        |
 *    | +------+   +--------+ |
 *    | | MAC0 |---| GE Phy |-+--- (unused)
 *    | +------+   +--------+ |
 *    | +------+   +--------+ |                 +---------+
 *    | | MAC1 |---| Uniphy |-+----- SGMII ------| QCA8081 |--- 2.5G PoE uplink
 *    | +------+   +--------+ |                 +---------+
 *    |_______________________|
 *
 * =================================================================
 */
&switch {
	status = "okay";
	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;

	qcom,port_phyinfo {
		port@1 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
		};

		port@2 {
			port_id = <2>;
			mdiobus = <&mdio1>;
			phy_address = <28>;
			port_mac_sel = "QGMAC_PORT";
		};
	};
};

&dp2 {
	status = "okay";
	label = "lan";
	phy-handle = <&qca8081>;
	nvmem-cells = <&macaddr_eeprom_0>;
	nvmem-cell-names = "mac-address";
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	qca8081: ethernet-phy@28 {
		compatible = "ethernet-phy-id004d.d101";
		reg = <28>;
		reset-deassert-us = <10000>;
		reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
	};
};

&pcie0_phy {
	status = "okay";
};

/* QCN9074 on the x2 controller */
&pcie0 {
	status = "okay";
	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";
			/* QCN9074: ath11k lacks DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;
			qcom,ath11k-calibration-variant = "Ubiquiti-U6-Enterprise-5G";
			qcom,ath11k-fw-memory-mode = <1>;
			/* read only by the NSS Wi-Fi offload */
			nss-radio-priority = <1>;
		};
	};
};

&pcie1_phy {
	status = "okay";
};

/* QCN9074 on the x1 controller */
&pcie1 {
	status = "okay";
	perst-gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;
			qcom,ath11k-calibration-variant = "Ubiquiti-U6-Enterprise-6G";
			qcom,ath11k-fw-memory-mode = <1>;
			/* read only by the NSS Wi-Fi offload */
			nss-radio-priority = <1>;
		};
	};
};

/*
 * As on the vendor firmware, the internal radio runs in its own user
 * protection domain, started after the root PD (multi-PD remoteproc).
 */
&q6_region {
	reg = <0x0 0x4b000000 0x0 0x3000000>;
};

&q6v5_wcss {
	compatible = "qcom,ipq5018-q6-mpd";
	firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt",
			"ath11k/IPQ5018/hw1.0/m3_fw.mdt";

	q6_wcss_pd1: pd-1 {
		firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt";

		interrupts-extended = <&wcss_smp2p_in 8 IRQ_TYPE_NONE>,
				      <&wcss_smp2p_in 9 IRQ_TYPE_NONE>,
				      <&wcss_smp2p_in 12 IRQ_TYPE_NONE>,
				      <&wcss_smp2p_in 11 IRQ_TYPE_NONE>;
		interrupt-names = "fatal",
				  "ready",
				  "spawn-ack",
				  "stop-ack";

		qcom,smem-states = <&wcss_smp2p_out 8>,
				   <&wcss_smp2p_out 9>,
				   <&wcss_smp2p_out 10>;
		qcom,smem-state-names = "shutdown",
					"stop",
					"spawn";
	};
};

&wifi {
	status = "okay";
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	/* past the multi-PD image, whose segments cover the default 0x4ba00000 */
	qcom,bdf-addr = <0x4c400000>;
	qcom,ath11k-calibration-variant = "Ubiquiti-U6-Enterprise";
	qcom,ath11k-fw-memory-mode = <1>;
};

&tlmm {
	button_pins: button-state {
		pins = "gpio24";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	emmc_pins: emmc-state {
		clk-pins {
			pins = "gpio9";
			function = "sdc1_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio8";
			function = "sdc1_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "sdc1_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	spi_0_pins: spi-0-state {
		pins = "gpio10", "gpio11", "gpio12", "gpio13";
		function = "blsp0_spi";
		drive-strength = <8>;
		bias-disable;
	};

	i2c_pins: i2c-state {
		pins = "gpio33", "gpio34";
		function = "blsp2_i2c0";
		drive-strength = <8>;
		bias-disable;
	};
};

&blsp1_i2c3 {
	pinctrl-0 = <&i2c_pins>;
	pinctrl-names = "default";
	status = "okay";

	accelerometer@18 {
		compatible = "st,lis2dh12-accel";
		reg = <0x18>;
	};
};

&usbphy0 {
	status = "okay";
};

&usb {
	status = "okay";
};

&usb_dwc {
	dr_mode = "host";
};
